{
  "name": "everywhere-marketplace-harness",
  "version": "1.0.0",
  "private": true,
  "description": "Marketplace of plugins and presets for Everywhere Harness",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "validate:index": "node scripts/validate-index.js",
    "publish:packages": "pnpm -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  },
  "type": "module"
}
